    <mxCell id="50" value="Redis&#xa;帖子详情缓存" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="640" width="150" height="100" as="geometry"/>
