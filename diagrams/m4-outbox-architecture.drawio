      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="53" value="⑩ 死信日志" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;fontSize=11;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="44" target="33">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="60" value="崩溃窗口分析（面试必考）：relay 已 publish 未 MarkProcessed 时崩溃 → 重启后重投同一条消息 → consumer 的 processed_events 去重表拦截 → 不重复计数。【至少一次投递 + 幂等消费 = 恰好一次效果】。代价：计数秒级延迟（最终一致性）；outbox 表需定期归档 processed 行。" style="text;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="40" y="880" width="1140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="61" value="受理与执行分离：API 只管“受理”（业务事务内埋事件），Worker 负责“执行”（投递/计数/失效缓存）。API 不依赖 MQ —— MQ 挂了点赞照样成功受理。" style="text;html=1;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="40" y="60" width="230" height="180" as="geometry"/>
    </mxCell>
  </root>
