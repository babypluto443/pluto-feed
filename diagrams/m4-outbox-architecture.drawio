    <mxCell id="45" value="⑥ publish + confirm 回执" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;html=1;" edge="1" parent="1" source="31" target="41">
      <mxGeometry relative="1" as="geometry"/>
